{
  "id": "obraids",
  "name": "oBraids",
  "abbrev": "oBRDS",
  "version": "0.4.2",
  "description": "Braids macro oscillator (the original DSP at its native 96 kHz) played on every 1/16 of Move's transport: 16 trigger pads, touch-recorded knob motion, a Phrase Gen RANDOM pad and a PITCH knob set in the scale",
  "author": "Hiro Ikezawa",
  "api_version": 2,
  "dsp": "dsp.so",
